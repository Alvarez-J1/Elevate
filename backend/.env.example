# Copy to .env and adjust for local overrides. docker-compose.yml reads these
# automatically; when running the jar directly, export them in your shell
# (or use a tool like `direnv`) before `java -jar target/elevate-backend.jar`.

# Local Docker values. For Render production, use SPRING_PROFILES_ACTIVE=prod
# and set DATABASE_URL to a JDBC PostgreSQL URL:
# jdbc:postgresql://host:5432/database
SPRING_PROFILES_ACTIVE=docker

POSTGRES_DB=elevate
DATABASE_URL=jdbc:postgresql://postgres:5432/elevate
DATABASE_USERNAME=elevate
DATABASE_PASSWORD=replace-with-a-local-postgres-password

# Must be at least 32 characters (HMAC-SHA256 requires a 256-bit key).
ELEVATE_JWT_SECRET=replace-with-a-random-local-secret-at-least-32-chars
ELEVATE_JWT_EXPIRATION_MS=86400000

ELEVATE_FRONTEND_ORIGIN=http://localhost:3000
